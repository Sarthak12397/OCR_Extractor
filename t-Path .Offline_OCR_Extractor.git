[32m+[m[32mdef get_status_code(error):[m
[32m+[m[32m    """Extract HTTP status code from a Gemini API exception."""[m
[32m+[m
[32m+[m[32m    status = ([m
[32m+[m[32m        getattr(error, "code", None)[m
[32m+[m[32m        or getattr(error, "status_code", None)[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    try:[m
[32m+[m[32m        if status is not None:[m
[32m+[m[32m            return int(status)[m
[32m+[m[32m    except (TypeError, ValueError):[m
[32m+[m[32m        pass[m
[32m+[m
[32m+[m[32m    # Fallback for exceptions where the status[m
[32m+[m[32m    # code is only available in the error message.[m
[32m+[m[32m    match = re.search([m
[32m+[m[32m        r"\b(429|500|502|503|504)\b",[m
[32m+[m[32m        str(error)[m
[32m+[m[32m    )[m
[32m+[m
[32m+[m[32m    if match:[m
[32m+[m[32m        return int(match.group(1))[m
[32m+[m
[32m+[m[32m    return None[m
[32m+[m
